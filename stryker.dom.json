{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "ВРЕМЕННЫЙ конфиг пункта 5 (DOM и геометрия): область сужена до client/{geometry,slides,presentation}. Удаляется вместе с пунктом.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/components/Carousel/client/geometry/**/*.ts",
    "src/components/Carousel/client/geometry/**/*.tsx",
    "src/components/Carousel/client/slides/**/*.ts",
    "src/components/Carousel/client/slides/**/*.tsx",
    "src/components/Carousel/client/presentation/**/*.ts",
    "src/components/Carousel/client/presentation/**/*.tsx",
    "!src/components/Carousel/client/**/tests/**",
    "!src/components/Carousel/client/**/index.ts",
    "!src/components/Carousel/client/**/types.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "timeoutMS": 20000,
  "concurrency": 4,
  "htmlReporter": {
    "fileName": "reports/mutation-dom/mutation.html"
  }
}
