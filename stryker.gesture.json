{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/shared/engines/gesture/**/*.ts",
    "src/components/Carousel/client/gesture/**/*.ts",
    "!src/shared/engines/**/tests/**",
    "!src/shared/engines/**/index.ts",
    "!src/shared/engines/**/types.ts",
    "!src/components/Carousel/client/**/tests/**",
    "!src/components/Carousel/client/**/index.ts",
    "!src/components/Carousel/client/**/types.ts"
  ],
  "htmlReporter": { "fileName": "reports/mutation-gesture/mutation.html" },
  "thresholds": { "high": 90, "low": 80, "break": null },
  "timeoutMS": 20000,
  "concurrency": 4
}
